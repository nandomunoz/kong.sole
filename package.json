{
  "name": "kong.sole",
  "version": "0.4.0",
  "description": "Make your browser console look good: kong.error(), inspect objects, tables, tags, timers, charts, banners and more. Dark and light aware. Zero dependencies.",
  "type": "module",
  "main": "./kong.sole.js",
  "module": "./kong.sole.js",
  "types": "./kong.sole.d.ts",
  "exports": {
    ".": {
      "types": "./kong.sole.d.ts",
      "default": "./kong.sole.js"
    },
    "./min": {
      "types": "./kong.sole.d.ts",
      "default": "./kong.sole.min.js"
    },
    "./lite": {
      "types": "./kong.sole.d.ts",
      "default": "./src/lite.js"
    },
    "./lite/min": {
      "types": "./kong.sole.d.ts",
      "default": "./kong.sole.lite.min.js"
    },
    "./core": {
      "types": "./kong.sole.d.ts",
      "default": "./src/core.js"
    },
    "./text": {
      "types": "./kong.sole.d.ts",
      "default": "./src/text.js"
    },
    "./images": {
      "types": "./kong.sole.d.ts",
      "default": "./src/images.js"
    },
    "./banners": {
      "types": "./kong.sole.d.ts",
      "default": "./src/banners.js"
    },
    "./say": {
      "types": "./kong.sole.d.ts",
      "default": "./src/say.js"
    },
    "./panels": {
      "types": "./kong.sole.d.ts",
      "default": "./src/panels.js"
    },
    "./helpers": {
      "types": "./kong.sole.d.ts",
      "default": "./src/helpers.js"
    },
    "./inspect": {
      "types": "./kong.sole.d.ts",
      "default": "./src/inspect.js"
    },
    "./debug": {
      "types": "./kong.sole.d.ts",
      "default": "./src/debug.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "kong.sole.js",
    "kong.sole.min.js",
    "kong.sole.lite.min.js",
    "kong.sole.d.ts",
    "src"
  ],
  "sideEffects": [
    "./kong.sole.js",
    "./src/*.js"
  ],
  "keywords": [
    "console",
    "kong",
    "log",
    "logger",
    "debug",
    "style",
    "svg",
    "base64",
    "banner",
    "browser",
    "devtools"
  ],
  "author": "Nando Muñoz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandovejer/kong.sole.git"
  },
  "homepage": "https://github.com/nandovejer/kong.sole#readme",
  "bugs": {
    "url": "https://github.com/nandovejer/kong.sole/issues"
  },
  "unpkg": "./kong.sole.min.js",
  "jsdelivr": "./kong.sole.min.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "vendor": "cp node_modules/@luz-ds/tokens/dist/tokens.min.css assets/luz-tokens.min.css && cp node_modules/@luz-ds/tokens/LICENSE assets/LUZ-LICENSE",
    "prepublishOnly": "npm run build && npm test",
    "types": "tsc -p types-test"
  },
  "devDependencies": {
    "@luz-ds/tokens": "0.4.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "terser": "^5.51.2",
    "typescript": "^7.0.2"
  }
}
